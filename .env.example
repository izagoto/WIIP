# Evidentra Platform — Environment Configuration
# Copy to .env and adjust values for your environment.

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SEED_ON_STARTUP=true

# Bootstrap users (development only — passwords stay in .env, never in source code)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@evidentra.local
SEED_ADMIN_PASSWORD=change-me-admin-password

SEED_INVESTIGATOR_USERNAME=investigator
SEED_INVESTIGATOR_EMAIL=investigator@evidentra.local
SEED_INVESTIGATOR_PASSWORD=change-me-investigator-password

# Database (SQLite for local dev)
DATABASE_URL=sqlite:///./evidentra.db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-development-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
STORAGE_PATH=./data/uploads
MAX_UPLOAD_SIZE_MB=100

# MinIO (production)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=evidentra-evidence
MINIO_USE_SSL=false
